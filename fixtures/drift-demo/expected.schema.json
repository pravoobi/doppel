{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://doppel.dev/schemas/expected.schema.json",
  "title": "Doppel fixture ground truth",
  "description": "Generated by scripts/generate-expected.mjs. Describes the drift planted in a fixture repo and the thresholds a Doppel run is graded against.",
  "type": "object",
  "required": ["version", "fixture", "designSystem", "targets", "cases", "negatives"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "fixture": { "type": "string" },
    "generatedBy": { "type": "string" },
    "note": { "type": "string" },
    "designSystem": {
      "type": "object",
      "required": ["path", "components"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Directory holding the design system, relative to the fixture root. Must be excluded from scanning."
        },
        "components": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "summary": { "type": "object" },
    "targets": {
      "type": "object",
      "required": ["detectionRecall", "minPrecision"],
      "properties": {
        "detectionRecall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of cases[] that must surface as candidates. Traps count — they are graded on classification, not on being skipped."
        },
        "minPrecision": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of flagged candidates that must correspond to a known case."
        },
        "maxFalsePositives": { "type": "integer", "minimum": 0 },
        "minClassificationAccuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "minVerdictAccuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "lineMatchTolerance": {
          "type": "integer",
          "minimum": 0,
          "description": "A scanner hit matches a case when it lands within this many lines of the recorded start."
        }
      }
    },
    "fileHashes": {
      "type": "object",
      "description": "Truncated sha256 per fixture file, pinning the content the line numbers were resolved against.",
      "additionalProperties": { "type": "string" }
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/definitions/case" }
    },
    "negatives": {
      "type": "array",
      "items": { "$ref": "#/definitions/negative" }
    }
  },
  "definitions": {
    "case": {
      "type": "object",
      "required": ["id", "kind", "file", "line", "anchor", "rootTag", "expect"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+-[0-9]{3}$" },
        "kind": {
          "type": "string",
          "enum": [
            "button",
            "card",
            "alert",
            "badge",
            "input",
            "table",
            "dialog",
            "trap:intentional",
            "trap:not-drift",
            "trap:unverifiable"
          ]
        },
        "file": { "type": "string" },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "Line of the candidate's opening tag. Derived from the anchor, never hand-written."
        },
        "anchor": {
          "type": "string",
          "description": "Unique substring inside the candidate, used to re-resolve the line when the fixture changes."
        },
        "anchorLine": { "type": "integer", "minimum": 1 },
        "rootTag": { "type": "string" },
        "snippet": { "type": "string" },
        "why": {
          "type": "string",
          "description": "Why this case exists. Surfaces in failure output so a red test explains itself."
        },
        "expect": {
          "type": "object",
          "required": ["detected", "matchedComponent", "classification"],
          "additionalProperties": false,
          "properties": {
            "detected": { "type": "boolean" },
            "matchedComponent": { "type": ["string", "null"] },
            "secondaryComponents": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Additional design-system components the migration should also introduce."
            },
            "classification": {
              "type": "string",
              "enum": ["DRIFT", "INTENTIONAL_DEVIATION", "NOT_DRIFT"]
            },
            "minTriageConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "risk": {
              "type": ["string", "null"],
              "enum": ["low", "medium", "high", null]
            },
            "unmappable": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Styles or behaviours the design-system component cannot express. Must be surfaced, never silently dropped."
            },
            "verdict": {
              "type": ["string", "null"],
              "enum": ["PASS", "REVIEW", "FAIL", "UNVERIFIABLE", null]
            },
            "patchGenerated": { "type": "boolean" },
            "unverifiableReason": { "type": "string" },
            "accessibilityGain": {
              "type": "string",
              "description": "What assistive-technology behaviour the migration restores. Drives the impact narrative."
            },
            "propMapping": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from", "to"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" },
                  "note": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "negative": {
      "type": "object",
      "required": ["id", "file", "line", "anchor", "rootTag", "expect"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^neg-[0-9]{3}$" },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "anchor": { "type": "string" },
        "rootTag": { "type": "string" },
        "snippet": { "type": "string" },
        "why": { "type": "string" },
        "expect": {
          "type": "object",
          "required": ["detected"],
          "additionalProperties": false,
          "properties": {
            "detected": { "type": "boolean", "const": false }
          }
        }
      }
    }
  }
}
