# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Sandboxes use the SAME NEBIUS_API_KEY above, not a separate credential, despite the docs
# reading otherwise (confirmed 2026-09-23, see docs/DECISIONS.md). NEBIUS_PROJECT_ID comes from
# tokenfactory.nebius.com/project/api-keys — required for spawn/list to actually work (whoami
# alone accepts a placeholder). Beta access granted and fully verified live as of 2026-09-23:
# echo + outbound network access (apt-get, curl to an external HTTPS host) both confirmed working.
SANDBOXES_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes/v1
NEBIUS_PROJECT_ID=

# M4: Postgres (Neon free tier), via @doppel/db's Drizzle schema. Get a connection string from
# a Neon project's dashboard (neon.tech) — the "pooled connection" string works fine with the
# @neondatabase/serverless HTTP driver this uses. Needed for the dashboard (apps/web) to show
# run history or start runs at all; everything up through M3 works without it.
DATABASE_URL=
GITHUB_TOKEN=  # M4 PR export. A fine-grained PAT with Contents + Pull requests
                # write access on the target repo. Never commit this file with
                # a real value filled in.
GITHUB_REPO_OWNER=  # e.g. "your-username" — the repo "Open PR" pushes a branch to
GITHUB_REPO_NAME=   # e.g. "drift-demo"
GITHUB_BASE_BRANCH=main

DOPPEL_MAX_SANDBOX_CONCURRENCY=8
DOPPEL_PIXEL_PASS_THRESHOLD=0.005
DOPPEL_PIXEL_REVIEW_THRESHOLD=0.05
